namespace lib;

let SEARCH: i32 = 0;
let LIKED: i32 = 1;
let HISTORY: i32 = 2;
let LOCAL: i32 = 3;
let PLAYLIST: i32 = 4;
let QUEUE: i32 = 5;

let TITLE: i32 = 0;
let ARTIST: i32 = 1;
let ALBUM: i32 = 2;
let KEY: i32 = 3;

let NP_TOGGLE: i32 = 1;
let NP_PLAY: i32 = 2;
let NP_PAUSE: i32 = 3;
let NP_NEXT: i32 = 4;
let NP_PREV: i32 = 5;
let NP_SEEK: i32 = 6;

extern fn open() = "lib_open";
extern fn close() = "lib_close";
