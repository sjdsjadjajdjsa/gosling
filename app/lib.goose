extern fn view() -> i32 = "lib_view";
extern fn view_playlist() -> i64 = "lib_view_playlist";
extern fn refresh() = "lib_refresh";
extern fn count() -> i32 = "lib_count";
extern fn field(i: i32, which: i32, out: u8[256]&) -> i32 = "lib_field";
extern fn duration(i: i32) -> f64 = "lib_duration";
extern fn art(i: i32, x: f32, y: f32, size: f32, bg: u32, fg: u32) = "lib_art";
extern fn current_row(i: i32) -> bool = "lib_current_row";
extern fn liked(i: i32) -> bool = "lib_liked";
extern fn like(i: i32) = "lib_like";
extern fn current_liked() -> bool = "lib_current_liked";
extern fn current_like() = "lib_current_like";
extern fn current_field(which: i32, out: u8[256]&) -> i32 = "lib_current_field";
extern fn current_url(out: u8[1024]&) -> i32 = "lib_current_url";
extern fn current_art(x: f32, y: f32, size: f32, bg: u32, fg: u32) = "lib_current_art";
extern fn current_title(title: const u8[:]) = "lib_current_title";
extern fn played() = "lib_played";
extern fn play_row(i: i32) = "lib_play_row";
extern fn play_url(url: const u8[:]) = "lib_play_url";
extern fn enqueue(i: i32) = "lib_enqueue";
extern fn next() -> bool = "lib_next";
extern fn prev() -> bool = "lib_prev";
extern fn has_next() -> bool = "lib_has_next";
extern fn has_prev() -> bool = "lib_has_prev";
extern fn has_current() -> bool = "lib_has_current";
extern fn now_playing(duration: f64, position: f64, playing: bool) = "lib_now_playing";
extern fn playlists() -> i32 = "lib_playlists";
extern fn playlist_id(i: i32) -> i64 = "lib_playlist_id";
extern fn playlist_name(i: i32, out: u8[256]&) -> i32 = "lib_playlist_name";
extern fn playlist_new() -> i64 = "lib_playlist_new";
extern fn playlist_rename(id: i64, name: const u8[:]) = "lib_playlist_rename";
