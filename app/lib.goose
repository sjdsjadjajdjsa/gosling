extern fn playlist_add(id: i64, i: i32) = "lib_playlist_add";
extern fn playlist_remove(i: i32) = "lib_playlist_remove";
extern fn add_folder(path: const u8[:]) = "lib_add_folder";
extern fn rescan() = "lib_rescan";
extern fn folders() -> i32 = "lib_folders";
extern fn pick_folder() -> bool = "lib_pick_folder";
extern fn is_dir(path: const u8[:]) -> bool = "lib_is_dir";
extern fn scanning() -> i32 = "scan_busy";
extern fn np_init() = "np_init";
extern fn discord_init() = "lib_discord_init";
extern fn discord_available() -> bool = "lib_discord_available";
