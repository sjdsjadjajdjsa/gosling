namespace ui;

let KEY_ENTER: i32 = 257;
let KEY_ESCAPE: i32 = 256;
let KEY_BACKSPACE: i32 = 259;
let KEY_SPACE: i32 = 32;
let KEY_LEFT: i32 = 263;
let KEY_RIGHT: i32 = 262;
let KEY_UP: i32 = 265;
let KEY_DOWN: i32 = 264;
let KEY_V: i32 = 86;
let CURSOR_DEFAULT: i32 = 0;
let CURSOR_TEXT: i32 = 2;
let CURSOR_HAND: i32 = 4;

extern fn open(title: const u8[:], w: i32, h: i32, min_w: i32, min_h: i32) = "ui_open";
extern fn running() -> bool = "ui_running";
extern fn visible() -> bool = "ui_visible";
extern fn icon(kind: i32, cx: f32, cy: f32, size: f32, level: i32, color: u32) = "ui_icon";
extern fn anim_begin() = "ui_anim_begin";
extern fn fade(id: i32, on: bool) -> f32 = "ui_fade";
extern fn animating() -> bool = "ui_animating";
extern fn mix(a: u32, b: u32, t: f32) -> u32 = "ui_mix";

let I_PLAY: i32 = 0;
let I_PAUSE: i32 = 1;
let I_PREV: i32 = 2;
let I_NEXT: i32 = 3;
let I_SEARCH: i32 = 4;
let I_PLUS: i32 = 5;
let I_SPEAKER: i32 = 6;
let I_CLOCK: i32 = 8;
let I_FOLDER: i32 = 9;
let I_LIST: i32 = 10;
let I_BIRD: i32 = 11;
let I_BARS: i32 = 12;
extern fn heart(cx: f32, cy: f32, size: f32, filled: bool, color: u32) = "ui_heart";
extern fn wait(timeout: f64) = "ui_wait";
extern fn time() -> f64 = "ui_time";
extern fn input() = "ui_input";
extern fn frame(bg: u32) = "ui_frame";
extern fn present() = "ui_present";
extern fn width() -> i32 = "ui_width";
extern fn height() -> i32 = "ui_height";
extern fn rect(x: f32, y: f32, w: f32, h: f32, r: f32, color: u32) = "ui_rect";
extern fn ring(x: f32, y: f32, inner: f32, outer: f32, start: f32, end: f32, color: u32) = "ui_ring";
extern fn circle(x: f32, y: f32, r: f32, color: u32) = "ui_circle";
extern fn triangle(x1: f32, y1: f32, x2: f32, y2: f32, x3: f32, y3: f32, color: u32) = "ui_triangle";
extern fn text(s: const u8[:], x: f32, y: f32, size: f32, color: u32) = "ui_text";
extern fn text_fit(s: const u8[:], x: f32, y: f32, size: f32, color: u32, max_w: f32) = "ui_text_fit";
extern fn text_width(s: const u8[:], size: f32) -> f32 = "ui_text_width";
extern fn clip(x: f32, y: f32, w: f32, h: f32) = "ui_clip";
extern fn unclip() = "ui_unclip";
extern fn mouse_x() -> f32 = "ui_mouse_x";
extern fn mouse_y() -> f32 = "ui_mouse_y";
extern fn mouse_pressed() -> bool = "ui_mouse_pressed";
extern fn mouse_down() -> bool = "ui_mouse_down";
extern fn mouse_released() -> bool = "ui_mouse_released";
extern fn wheel() -> f32 = "ui_wheel";
extern fn next_char() -> i32 = "ui_char";
extern fn key(k: i32) -> bool = "ui_key";
extern fn command() -> bool = "ui_command";
extern fn paste(out: u8[1024]&) -> i32 = "ui_paste";
extern fn dropped(out: u8[1024]&) -> i32 = "ui_dropped";
extern fn cursor(kind: i32) = "ui_cursor";
extern fn close() = "ui_close";
